{
  "name": "signal-starter",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Signal — Astro + Keystatic + Markdoc starter",
  "scripts": {
    "astro": "astro",
    "build": "cross-env SKIP_KEYSTATIC=true astro build",
    "check:content": "node scripts/check-assessment-ids.mjs",
    "check:lifecycle": "node scripts/check-status-lifecycle.mjs",
    "dev": "cross-env SKIP_KEYSTATIC=true astro dev",
    "preview": "cross-env SKIP_KEYSTATIC=true astro preview",
    "start": "cross-env SKIP_KEYSTATIC=true astro dev",
    "typecheck": "cross-env SKIP_KEYSTATIC=true astro check",
    "test": "vitest run",
    "test:rules": "vitest run tests/rules",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "seed:playwright-user": "tsx scripts/seed-playwright-user.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdoc": "^0.15.11",
    "@astrojs/react": "^4.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@keystatic/astro": "^5.0.6",
    "@keystatic/core": "^0.5.50",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "astro": "^5.18.1",
    "firebase": "^11.10.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.17.0",
    "cross-env": "^10.1.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
