rules_version = '2';

// Signal Firestore security rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // Sprint 7A Inc 7.0: teacher allowlist.
    //
    // Returns true if the authenticated request is from an allowlisted
    // teacher email. Used to grant cross-user READ access on a strict
    // subset of student data: profile, drillRatings, activity sessions
    // and activity attempts. Teachers DO NOT have read access to
    // /users/{uid}/submissions, because those documents carry NEI
    // prose bodies in answerText. The prose-body boundary is the v1
    // security line; see docs/sprint-7-scope.md §3.3 and Risk R1.
    //
    // Teachers also do not have any write access. All writes remain
    // student-only.
    //
    // The allowlist is hardcoded server-side. A compromised client
    // cannot read another user's data even if it claims to be a
    // teacher. To add a teacher pre-pilot, append an email here and
    // deploy to BOTH environments (Trap 12):
    //   firebase deploy --only firestore:rules --project signal-staging-26b3e
    //   firebase deploy --only firestore:rules --project mark-scheme-method-3efe9
    //
    // Pre-pilot TODO: replace the placeholder with Chris's and Dave's
    // real emails before 21 September 2026. The placeholder string is
    // intentionally never going to match a real Firebase auth token,
    // so the rule set is safe to ship with the placeholder in place.
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email in [
             "teacher-pilot-placeholder@example.com"
           ];
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isTeacher());

      match /submissions/{submissionId} {
        // Student-only. Teachers DO NOT read submission docs because
        // they contain the NEI prose body in answerText. v1 holds the
        // line at counts + timestamps via a future submissionsIndex
        // collection (deferred). Widening this rule requires a
        // Section 8 entry in docs/sprint-7-scope.md.
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll([
               'topicId', 'questionId', 'answerText',
               'submittedAt', 'marking', 'source'
             ])
          && request.resource.data.source == 'signal'
          && request.resource.data.topicId is string
          && request.resource.data.questionId is string
          && request.resource.data.answerText is string
          && request.resource.data.marking is map;
        allow update, delete: if false;
      }

      match /mcqSubmissions/{submissionId} {
        // Sprint 7B Inc 7B.0: per-question MCQ submission records.
        //
        // Sprint 7C Inc 7C.0 (2026-05-16) widened the read rule to
        // grant allowlisted teachers cross-user READ access, mirroring
        // the drillRatings and activity-session read predicates. The
        // NEI prose boundary at /submissions is NOT widened; Sort &
        // Match and Twin Tracks scenario-level attempts are NOT
        // widened. See docs/sprint-7c-scope.md §3.2 for the named
        // boundaries this widening does and does not affect.
        //
        // Writes remain student-only. Delete remains denied. Teachers
        // have no write or delete capability anywhere.
        //
        // Upsert semantics: create and update both allowed under the
        // same predicates. Re-attempting an MCQ overwrites the
        // previous submission. No attempt history; the latest answer
        // is the unit of measurement per Sprint 7B scope §3.2.
        allow read: if request.auth != null
          && (request.auth.uid == userId || isTeacher());
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll([
               'topicId', 'questionId', 'selectedIndex', 'correctIndex',
               'isCorrect', 'submittedAt', 'source'
             ])
          && request.resource.data.source == 'signal'
          && request.resource.data.topicId is string
          && request.resource.data.questionId is string
          && request.resource.data.selectedIndex is int
          && request.resource.data.selectedIndex >= 0
          && request.resource.data.selectedIndex <= 10
          && request.resource.data.correctIndex is int
          && request.resource.data.correctIndex >= 0
          && request.resource.data.correctIndex <= 10
          && request.resource.data.isCorrect is bool
          && request.resource.data.isCorrect ==
               (request.resource.data.selectedIndex == request.resource.data.correctIndex)
          && request.resource.data.submittedAt is timestamp;
        allow delete: if false;
      }

      match /drillRatings/{ratingId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isTeacher());
        // Sprint 6 extends this block with optional spaced-return scheduler fields.
        // The five legacy fields remain required so existing saveDrillRating writes
        // pass; new fields (boxLevel, nextReviewDate, firstRatedAt, lastRatedAt,
        // history) are validated only when present, so a write without them still
        // succeeds. Wiring of the scheduler write path lands in Inc 6.1 / 6.4.
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll([
               'topicId', 'termId', 'outcome', 'ratedAt', 'source'
             ])
          && request.resource.data.source == 'signal'
          && request.resource.data.topicId is string
          && request.resource.data.termId is string
          && (request.resource.data.outcome == 'got'
              || request.resource.data.outcome == 'miss')
          && (!('boxLevel' in request.resource.data)
              || (request.resource.data.boxLevel is int
                  && request.resource.data.boxLevel >= 0
                  && request.resource.data.boxLevel <= 4))
          && (!('nextReviewDate' in request.resource.data)
              || (request.resource.data.nextReviewDate is timestamp
                  && request.resource.data.nextReviewDate
                       <= request.time + duration.value(60, 'd')))
          && (!('firstRatedAt' in request.resource.data)
              || request.resource.data.firstRatedAt is timestamp)
          && (!('lastRatedAt' in request.resource.data)
              || request.resource.data.lastRatedAt is timestamp)
          && (!('history' in request.resource.data)
              || (request.resource.data.history is list
                  && request.resource.data.history.size() <= 10));
        allow delete: if false;
      }

      match /data/{dataKey}/sessions/{sessionId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isTeacher())
          && (dataKey == 'risk-classifier'
              || dataKey == 'sort-and-match'
              || dataKey == 'twin-tracks');

        allow create: if request.auth != null
          && request.auth.uid == userId
          && (
            (dataKey == 'risk-classifier'
              && request.resource.data.keys().hasAll([
                   'startedAt', 'completedAt', 'totalScenarios',
                   'score', 'mode', 'source'
                 ])
              && request.resource.data.source == 'signal'
              && (request.resource.data.mode == 'first-attempt'
                  || request.resource.data.mode == 'replay-wrong'
                  || request.resource.data.mode == 'challenge')
              && request.resource.data.completedAt == null
              && request.resource.data.totalScenarios == null
              && request.resource.data.score == 0)
            ||
            (dataKey == 'sort-and-match'
              && request.resource.data.keys().hasAll([
                   'startedAt', 'completedAt', 'totalScenarios',
                   'score', 'mode', 'source'
                 ])
              && request.resource.data.source == 'signal'
              && request.resource.data.mode == 'first-attempt'
              && request.resource.data.completedAt == null
              && request.resource.data.totalScenarios == null
              && request.resource.data.score == 0)
            ||
            (dataKey == 'twin-tracks'
              && request.resource.data.keys().hasAll([
                   'startedAt', 'completedAt', 'totalScenarios',
                   'score', 'mode', 'source'
                 ])
              && request.resource.data.source == 'signal'
              && request.resource.data.mode == 'first-attempt'
              && request.resource.data.completedAt == null
              && request.resource.data.totalScenarios == null
              && request.resource.data.score == 0)
          );

        allow update: if request.auth != null
          && request.auth.uid == userId
          && (dataKey == 'risk-classifier'
              || dataKey == 'sort-and-match'
              || dataKey == 'twin-tracks')
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.mode == resource.data.mode
          && request.resource.data.source == resource.data.source
          && request.resource.data.totalScenarios is int
          && request.resource.data.totalScenarios >= 1
          && request.resource.data.totalScenarios <= 20
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= request.resource.data.totalScenarios;

        allow delete: if false;

        match /attempts/{attemptId} {
          allow read: if request.auth != null
            && (request.auth.uid == userId || isTeacher())
            && (dataKey == 'risk-classifier'
                || dataKey == 'sort-and-match'
                || dataKey == 'twin-tracks');

          allow create: if request.auth != null
            && request.auth.uid == userId
            && (
              (dataKey == 'risk-classifier'
                && request.resource.data.keys().hasAll([
                     'scenarioId', 'tierChosen', 'correctTier',
                     'isCorrect', 'timeToAnswerMs', 'viewedReasoning',
                     'attemptedAt', 'source'
                   ])
                && request.resource.data.source == 'signal'
                && request.resource.data.scenarioId is string
                && request.resource.data.tierChosen is string
                && request.resource.data.correctTier is string
                && request.resource.data.isCorrect ==
                     (request.resource.data.tierChosen == request.resource.data.correctTier)
                && request.resource.data.timeToAnswerMs is int
                && request.resource.data.timeToAnswerMs >= 0
                && request.resource.data.viewedReasoning is bool)
              ||
              (dataKey == 'sort-and-match'
                && request.resource.data.keys().hasAll([
                     'scenarioId', 'attemptNumber', 'placements',
                     'isCorrect', 'correctCount', 'totalPhrases',
                     'timeToCheckMs', 'attemptedAt', 'source'
                   ])
                && request.resource.data.source == 'signal'
                && request.resource.data.scenarioId is string
                && request.resource.data.attemptNumber is int
                && request.resource.data.attemptNumber >= 1
                && request.resource.data.attemptNumber <= 3
                && request.resource.data.placements is map
                && request.resource.data.isCorrect is bool
                && request.resource.data.correctCount is int
                && request.resource.data.correctCount >= 0
                && request.resource.data.totalPhrases is int
                && request.resource.data.totalPhrases >= 1
                && request.resource.data.totalPhrases <= 20
                && request.resource.data.correctCount <= request.resource.data.totalPhrases
                && request.resource.data.isCorrect ==
                     (request.resource.data.correctCount == request.resource.data.totalPhrases)
                && request.resource.data.timeToCheckMs is int
                && request.resource.data.timeToCheckMs >= 0)
              ||
              (dataKey == 'twin-tracks'
                && request.resource.data.keys().hasAll([
                     'scenarioId', 'phraseId', 'correctTrack', 'correctSlot',
                     'wrongDropCount', 'revealed', 'timeToLockMs',
                     'attemptedAt', 'source'
                   ])
                && request.resource.data.source == 'signal'
                && request.resource.data.scenarioId is string
                && request.resource.data.phraseId is string
                && (request.resource.data.correctTrack == 'positive'
                    || request.resource.data.correctTrack == 'negative')
                && (request.resource.data.correctSlot == 'introduce'
                    || request.resource.data.correctSlot == 'explain'
                    || request.resource.data.correctSlot == 'develop')
                && request.resource.data.wrongDropCount is int
                && request.resource.data.wrongDropCount >= 0
                && request.resource.data.wrongDropCount <= 3
                && request.resource.data.revealed is bool
                && request.resource.data.revealed ==
                     (request.resource.data.wrongDropCount >= 3)
                && request.resource.data.timeToLockMs is int
                && request.resource.data.timeToLockMs >= 0)
            );

          allow update, delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
