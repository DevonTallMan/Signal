# Copy this to .env and fill in from the Firebase console:
# Project settings > General > Your apps > Web > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Must match the region declared in functions/index.js setGlobalOptions.
VITE_FUNCTIONS_REGION=europe-west2
