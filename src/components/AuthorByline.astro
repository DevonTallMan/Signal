---
import { getEntry } from 'astro:content';

interface Props {
  authorIds: string[];
}

const { authorIds } = Astro.props;

// Resolve author references. If an ID doesn't match, we render it as a plain
// string rather than crashing the build — useful during migration when
// bylines may reference authors not yet created.
const authors = await Promise.all(
  authorIds.map(async (id) => {
    const entry = await getEntry('authors', id);
    return entry?.data ?? { display_name: id, role: 'teacher' as const };
  })
);
---

<div class="meta">
  By
  {
    authors.map((author, i) => (
      <span>
        <strong style="color: var(--ink);">{author.display_name}</strong>
        {author.institution && (
          <span style="color: var(--muted);"> · {author.institution}</span>
        )}
        {i < authors.length - 1 ? ', ' : ''}
      </span>
    ))
  }
</div>
