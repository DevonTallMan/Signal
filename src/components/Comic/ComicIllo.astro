---
// Comic-panel SVG illustration.
//
// Inc 7.0 shipped a placeholder that names the panel slot it occupied.
// Inc 7.1 added the first real per-topic illustration set: six SVGs
// for the CA 4.1 Computer Misuse Act topic, keyed cma-*.
// Inc 7.2 added six more, for the CA 4.1 Equality Act topic, keyed eq-*.
// Inc 7.3 adds six more, for the CA 4.1 Intellectual Property topic,
// keyed ip-*. With this increment all four CA 4.1 legislation topics
// either run on the comic format (CMA, Equality, IP) or carry the
// prose-with-illos treatment from PR #117 (Data Protection).
//
// The unknown-panel fallback is preserved so the Inc 7.0
// comic-format-preview stub (which uses DP-themed panel keys) still
// renders with a clearly-marked placeholder until those topics get
// their own per-panel SVGs in a later increment.

interface Props {
  panel: string;
}
const { panel } = Astro.props;

const authoredPanels = new Set([
  "cma-boundary",
  "cma-five",
  "cma-unauth",
  "cma-computer",
  "cma-mens",
  "cma-origin",
  "eq-nine",
  "eq-forms",
  "eq-pcp",
  "eq-adjustments",
  "eq-justify",
  "eq-enforce",
  "ip-regimes",
  "ip-automatic",
  "ip-ownership",
  "ip-assign",
  "ip-software",
  "ip-opensource",
]);
const isPlaceholder = !authoredPanels.has(panel);
---
<div class="comic-illo" data-panel={panel} aria-hidden="true">
