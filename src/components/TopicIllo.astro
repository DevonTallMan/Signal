---
// src/components/TopicIllo.astro
//
// Cyberpunk-style SVG illustration for topic-page section breaks.
// Rendered via the {% illo panel="..." /%} Markdoc block tag (see
// markdoc.config.mjs).
//
// Currently scoped to the CA 4.1 Data Protection topic (six panels).
// If we later want to give CMA / Equality / IP the same treatment, the
// pattern is: add new panel keys here, new SVG markup per panel, and
// extend the Markdoc `matches` whitelist.
//
// Palette follows the Signal convention:
//   --green  = NAME / primary structural cue
//   --gold   = EXPLAIN / secondary cue
//   --amber  = IMPACT / accent
//
// All SVGs are decorative; aria-hidden="true" is set so screen readers
// skip them. The prose around the illustration carries the meaning.

type Panel =
  | "scope"
  | "regime"
  | "actors"
  | "principles"
  | "lawful-bases"
  | "rights";

interface Props {
  panel: Panel;
}

const { panel } = Astro.props;

const labels: Record<Panel, { num: string; tag: string }> = {
  scope: { num: "01_SCOPE", tag: "WHEN DP APPLIES" },
  regime: { num: "02_REGIME", tag: "THE LAW IS A PAIR" },
  actors: { num: "03_ACTORS", tag: "WHO IS WHO" },
  principles: { num: "04_PRINCIPLES", tag: "UK GDPR ARTICLE 5" },
  "lawful-bases": { num: "05_LAWFUL_BASES", tag: "UK GDPR ARTICLE 6" },
  rights: { num: "06_RIGHTS", tag: "UK GDPR CHAPTER III" },
};
const { num, tag } = labels[panel];
---

<figure class="topic-illo" data-panel={panel}>
  <div class="topic-illo__frame" aria-hidden="true">
    {panel === "scope" && (
      <svg viewBox="0 0 320 140" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
        <g stroke="rgba(57,255,20,0.15)" stroke-width="0.5">
          <line x1="0" y1="35" x2="320" y2="35"/>
          <line x1="0" y1="105" x2="320" y2="105"/>
          <line x1="60" y1="0" x2="60" y2="140"/>
          <line x1="260" y1="0" x2="260" y2="140"/>
        </g>
        <g stroke="#39ff14" stroke-width="2.5" fill="none">
          <path d="M 8 8 L 8 26 M 8 8 L 26 8"/>
          <path d="M 312 8 L 312 26 M 312 8 L 294 8"/>
          <path d="M 8 132 L 8 114 M 8 132 L 26 132"/>
          <path d="M 312 132 L 312 114 M 312 132 L 294 132"/>
        </g>
        <ellipse cx="160" cy="70" rx="90" ry="42" fill="none" stroke="#39ff14" stroke-width="3"/>
        <ellipse cx="160" cy="70" rx="68" ry="30" fill="none" stroke="#ffd700" stroke-width="1" stroke-dasharray="4 3"/>
        <circle cx="160" cy="70" r="22" fill="#0a0b10" stroke="#39ff14" stroke-width="2.5"/>
        <circle cx="160" cy="70" r="13" fill="none" stroke="#ffd700" stroke-width="1.5"/>
        <circle cx="160" cy="70" r="5" fill="#ff9d3a"/>
        <line x1="160" y1="48" x2="160" y2="92" stroke="#ffd700" stroke-width="1" opacity="0.7"/>
        <line x1="138" y1="70" x2="182" y2="70" stroke="#ffd700" stroke-width="1" opacity="0.7"/>
        <text x="14" y="135" fill="#39ff14" font-family="monospace" font-size="9" opacity="0.7">&gt; SYSTEMS_SCANNED</text>
        <text x="232" y="135" fill="#ff9d3a" font-family="monospace" font-size="9" opacity="0.7">PERSONAL_DATA_FOUND</text>
      </svg>
    )}
    {panel === "regime" && (
      <svg viewBox="0 0 320 140" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
        <g transform="translate(75, 70)">
          <polygon points="-42,0 -21,-36 21,-36 42,0 21,36 -21,36" fill="#11141c" stroke="#39ff14" stroke-width="3"/>
          <text x="0" y="-5" text-anchor="middle" fill="#39ff14" font-family="'Orbitron',sans-serif" font-size="13" font-weight="700">UK GDPR</text>
          <text x="0" y="12" text-anchor="middle" fill="#39ff14" font-family="monospace" font-size="8" opacity="0.7">RULEBOOK</text>
        </g>
        <g transform="translate(245, 70)">
          <polygon points="-42,0 -21,-36 21,-36 42,0 21,36 -21,36" fill="#11141c" stroke="#ffd700" stroke-width="3"/>
          <text x="0" y="-5" text-anchor="middle" fill="#ffd700" font-family="'Orbitron',sans-serif" font-size="13" font-weight="700">DPA 2018</text>
          <text x="0" y="12" text-anchor="middle" fill="#ffd700" font-family="monospace" font-size="8" opacity="0.7">UK ACT</text>
        </g>
        <line x1="117" y1="70" x2="142" y2="70" stroke="#ff9d3a" stroke-width="2.5"/>
        <line x1="178" y1="70" x2="203" y2="70" stroke="#ff9d3a" stroke-width="2.5"/>
        <g transform="translate(160, 70)">
          <circle r="22" fill="#0a0b10" stroke="#ff9d3a" stroke-width="3"/>
          <text x="0" y="4" text-anchor="middle" fill="#ff9d3a" font-family="'Orbitron',sans-serif" font-size="11" font-weight="600">=</text>
        </g>
        <text x="160" y="128" text-anchor="middle" fill="#ff9d3a" font-family="monospace" font-size="10" letter-spacing="3">ONE REGIME</text>
      </svg>
    )}
    {panel === "actors" && (
      <svg viewBox="0 0 320 140" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
        <g transform="translate(60, 75)">
          <circle r="14" fill="none" stroke="#39ff14" stroke-width="2.5"/>
          <circle cx="0" cy="-3" r="5" fill="#39ff14"/>
          <path d="M -7 5 Q 0 12 7 5" fill="none" stroke="#39ff14" stroke-width="2"/>
          <text x="0" y="38" text-anchor="middle" fill="#39ff14" font-family="monospace" font-size="9" font-weight="600">SUBJECT</text>
        </g>
        <g stroke="#ff9d3a" stroke-width="2" stroke-dasharray="3 3" fill="none">
          <line x1="80" y1="75" x2="135" y2="75"/>
        </g>
        <g transform="translate(160, 75)">
          <rect x="-26" y="-22" width="52" height="44" fill="#11141c" stroke="#ffd700" stroke-width="2.5"/>
          <rect x="-26" y="-22" width="52" height="8" fill="#ffd700" opacity="0.25"/>
          <g stroke="#ffd700" stroke-width="1.2" fill="none">
            <line x1="-18" y1="-6" x2="18" y2="-6"/>
            <line x1="-18" y1="2" x2="14" y2="2"/>
            <line x1="-18" y1="10" x2="16" y2="10"/>
          </g>
          <text x="0" y="38" text-anchor="middle" fill="#ffd700" font-family="monospace" font-size="9" font-weight="600">CONTROLLER</text>
        </g>
        <g stroke="#ff9d3a" stroke-width="2" stroke-dasharray="3 3" fill="none">
          <line x1="186" y1="75" x2="234" y2="75"/>
        </g>
        <g transform="translate(258, 75)">
          <rect x="-22" y="-22" width="44" height="44" fill="#11141c" stroke="#ff9d3a" stroke-width="2.5"/>
          <g stroke="#ff9d3a" stroke-width="1.2" fill="none">
            <circle cx="0" cy="-4" r="6"/>
            <path d="M -10 14 Q -10 6 0 6 Q 10 6 10 14"/>
          </g>
          <text x="0" y="38" text-anchor="middle" fill="#ff9d3a" font-family="monospace" font-size="9" font-weight="600">PROCESSOR</text>
        </g>
        <text x="14" y="130" fill="#39ff14" font-family="monospace" font-size="9" opacity="0.7">&gt; ACTORS :: WHO_IS_WHO</text>
      </svg>
    )}
    {panel === "principles" && (
      <svg viewBox="0 0 320 140" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
        <g transform="translate(160, 70)">
          <circle r="40" fill="none" stroke="#39ff14" stroke-width="2.5"/>
          <circle r="40" fill="none" stroke="#ffd700" stroke-width="1" stroke-dasharray="4 4" opacity="0.6"/>
          <text x="0" y="-4" text-anchor="middle" fill="#39ff14" font-family="'Orbitron',sans-serif" font-size="13" font-weight="700">ART 5</text>
          <text x="0" y="12" text-anchor="middle" fill="#39ff14" font-family="monospace" font-size="9" opacity="0.8">7 PRINCIPLES</text>
        </g>
        <g fill="#ffd700" font-family="monospace" font-size="8" letter-spacing="1">
          <text x="160" y="22" text-anchor="middle">LAWFUL</text>
          <text x="232" y="55" text-anchor="middle">PURPOSE</text>
          <text x="252" y="100" text-anchor="middle">MINIMISE</text>
          <text x="195" y="128" text-anchor="middle">ACCURATE</text>
          <text x="125" y="128" text-anchor="middle">STORAGE</text>
          <text x="68" y="100" text-anchor="middle">SECURITY</text>
          <text x="88" y="55" text-anchor="middle">ACCOUNT</text>
        </g>
        <g stroke="#ffd700" stroke-width="0.8" opacity="0.4">
          <line x1="160" y1="30" x2="160" y2="35"/>
          <line x1="220" y1="55" x2="200" y2="60"/>
          <line x1="232" y1="92" x2="200" y2="86"/>
          <line x1="190" y1="120" x2="178" y2="105"/>
          <line x1="130" y1="120" x2="142" y2="105"/>
          <line x1="88" y1="92" x2="120" y2="86"/>
          <line x1="100" y1="55" x2="120" y2="60"/>
        </g>
      </svg>
    )}
    {panel === "lawful-bases" && (
      <svg viewBox="0 0 320 140" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
        <g transform="translate(40, 70)">
          <rect x="-22" y="-30" width="44" height="60" fill="#11141c" stroke="#39ff14" stroke-width="2"/>
          <text x="0" y="-15" text-anchor="middle" fill="#39ff14" font-family="monospace" font-size="8" font-weight="700">A</text>
          <text x="0" y="0" text-anchor="middle" fill="#39ff14" font-family="monospace" font-size="7">CONSENT</text>
        </g>
        <g transform="translate(95, 70)">
          <rect x="-22" y="-30" width="44" height="60" fill="#11141c" stroke="#ffd700" stroke-width="2"/>
          <text x="0" y="-15" text-anchor="middle" fill="#ffd700" font-family="monospace" font-size="8" font-weight="700">B</text>
          <text x="0" y="0" text-anchor="middle" fill="#ffd700" font-family="monospace" font-size="7">CONTRACT</text>
        </g>
        <g transform="translate(150, 70)">
          <rect x="-22" y="-30" width="44" height="60" fill="#11141c" stroke="#ff9d3a" stroke-width="2"/>
          <text x="0" y="-15" text-anchor="middle" fill="#ff9d3a" font-family="monospace" font-size="8" font-weight="700">C</text>
          <text x="0" y="0" text-anchor="middle" fill="#ff9d3a" font-family="monospace" font-size="7">LEGAL OB</text>
        </g>
        <g transform="translate(205, 70)">
          <rect x="-22" y="-30" width="44" height="60" fill="#11141c" stroke="#39ff14" stroke-width="2"/>
          <text x="0" y="-15" text-anchor="middle" fill="#39ff14" font-family="monospace" font-size="8" font-weight="700">D</text>
          <text x="0" y="0" text-anchor="middle" fill="#39ff14" font-family="monospace" font-size="7">VITAL INT</text>
        </g>
        <g transform="translate(260, 70)">
          <rect x="-22" y="-30" width="44" height="60" fill="#11141c" stroke="#ffd700" stroke-width="2"/>
          <text x="0" y="-15" text-anchor="middle" fill="#ffd700" font-family="monospace" font-size="8" font-weight="700">E</text>
          <text x="0" y="0" text-anchor="middle" fill="#ffd700" font-family="monospace" font-size="7">PUBLIC TASK</text>
        </g>
        <g transform="translate(160, 22)">
          <ellipse rx="32" ry="10" fill="#11141c" stroke="#ff9d3a" stroke-width="2"/>
          <text x="0" y="3" text-anchor="middle" fill="#ff9d3a" font-family="monospace" font-size="8" font-weight="700">F :: LEGITIMATE INT</text>
        </g>
        <text x="14" y="130" fill="#39ff14" font-family="monospace" font-size="9" opacity="0.7">&gt; ART_6 :: PICK_ONE</text>
      </svg>
    )}
    {panel === "rights" && (
      <svg viewBox="0 0 320 140" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
        <g transform="translate(60, 70)">
          <circle r="40" fill="none" stroke="#39ff14" stroke-width="2"/>
          <circle r="14" fill="none" stroke="#39ff14" stroke-width="2.5"/>
          <circle cx="0" cy="-3" r="5" fill="#39ff14"/>
          <path d="M -7 5 Q 0 12 7 5" fill="none" stroke="#39ff14" stroke-width="2"/>
          <text x="0" y="60" text-anchor="middle" fill="#39ff14" font-family="monospace" font-size="9" font-weight="600">DATA SUBJECT</text>
        </g>
        <g stroke="#ffd700" stroke-width="1.5" fill="none">
          <path d="M 100 50 L 150 50"/>
          <path d="M 100 62 L 150 62"/>
          <path d="M 100 74 L 150 74"/>
          <path d="M 100 86 L 150 86"/>
          <path d="M 100 50 L 105 47 M 100 50 L 105 53"/>
          <path d="M 100 62 L 105 59 M 100 62 L 105 65"/>
          <path d="M 100 74 L 105 71 M 100 74 L 105 77"/>
          <path d="M 100 86 L 105 83 M 100 86 L 105 89"/>
        </g>
        <g font-family="monospace" font-size="8" fill="#ffd700">
          <text x="160" y="44">ACCESS</text>
          <text x="160" y="56">RECTIFY</text>
          <text x="160" y="68">ERASE</text>
          <text x="160" y="80">RESTRICT</text>
          <text x="160" y="92">PORTABILITY</text>
          <text x="160" y="104">OBJECT</text>
          <text x="160" y="116">NO AUTO-DECIDE</text>
        </g>
        <text x="14" y="135" fill="#39ff14" font-family="monospace" font-size="9" opacity="0.7">&gt; SEVEN_RIGHTS_GRANTED</text>
      </svg>
    )}
  </div>
  <figcaption class="topic-illo__caption">
    <span class="topic-illo__num">{num}</span>
    <span class="topic-illo__tag">{tag}</span>
  </figcaption>
</figure>
