---
// src/pages/index.astro
//
// Signal's home/landing page. Ported from the legacy Edtech marketing
// landing (devontallman.github.io/Edtech/) with links rewired to
// Signal's actual content routes.
//
// This PR contains Path B only: hero + two paper tiles.
// Follow-up PRs will add:
//   - Interactive Answer Arc demo (as a proper React island reusing
//     Signal's existing NEISubmission infrastructure)
//   - "How it works" section
//   - Page animations (particles, glitch, count-up)
//
// The nav for this page is inline (not the shared Signal nav from
// BaseLayout.astro). The landing uses its own cyberpunk nav. The
// rest of Signal continues to use BaseLayout.astro.

import LandingLayout from '~/layouts/LandingLayout.astro';
import AnswerArcDemo from '~/components/AnswerArcDemo';
import AuthNav from '~/components/AuthNav';
import '~/styles/landing.css';
---

<LandingLayout
  title="Signal — T-Level Digital Study Platform"
  description="Teacher-created content and structured answer training for T-Level Digital core papers. Built by the people delivering it."
>
  <header role="banner">
    <nav class="nav" role="navigation" aria-label="Main navigation">
      <div class="nav-left">
        <div class="nav-logo">SIGNAL<span>.</span></div>
        <div class="nav-sub">T-LEVEL DIGITAL</div>
      </div>
      <div class="nav-links">
        <a href="#papers" class="nav-link">CONTENT AREAS</a>
        <a href="#activities" class="nav-link">ACTIVITIES</a>
        <a href="#answer-arc" class="nav-link">ANSWER ARC</a>
        <a
          href="https://github.com/DevonTallMan/Signal"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-link"
        >GITHUB</a>
        <AuthNav client:load landingVariant />
      </div>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero">
      <div class="hero-glow"></div>
      <div class="hero-glow hero-glow-gold"></div>
      <div class="hero-glow hero-glow-cyan"></div>
      <div class="hero-vignette"></div>
      <div class="hero-grid-fine"></div>
      <div class="hero-hline hero-hline-1"></div>
      <div class="hero-hline hero-hline-2"></div>
      <div class="hero-hline hero-hline-3"></div>
      <div class="hero-corner hero-corner-tl"></div>
      <div class="hero-corner hero-corner-tr"></div>
      <div class="hero-corner hero-corner-bl"></div>
      <div class="hero-corner hero-corner-br"></div>
      <svg
        class="hero-circuits"
        viewBox="0 0 1200 700"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M0,200 L120,200 L160,240 L400,240"
          stroke="rgba(57,255,20,0.08)"
          stroke-width="1"
          fill="none"></path>
        <path
          d="M0,350 L80,350 L120,310 L300,310 L340,350 L500,350"
          stroke="rgba(57,255,20,0.06)"
          stroke-width="1"
          fill="none"></path>
        <path
          d="M1200,150 L1080,150 L1040,190 L820,190"
          stroke="rgba(255,215,0,0.07)"
          stroke-width="1"
          fill="none"></path>
        <circle cx="400" cy="240" r="3" fill="rgba(57,255,20,0.2)"></circle>
        <circle cx="820" cy="190" r="3" fill="rgba(255,215,0,0.2)"></circle>
      </svg>

      <div class="hero-eyebrow">
        <span class="eyebrow-tag">TEACHER-CREATED</span>
        <span class="eyebrow-dot"></span>
        <span class="eyebrow-tag2">BOTH CORE PAPERS</span>
      </div>

      <h1>
        Learn the content.<br />
        Then learn to <span class="green">answer</span> the
        <span class="gold">question.</span>
      </h1>

      <p class="hero-sub">
        Knowing your subject and being able to
        <strong>turn that knowledge into marks</strong> are two different skills.
        Signal teaches both, whether you're just starting out or preparing to sit
        the exam.
      </p>

      <p class="hero-detail">
        COVERING BOTH CORE PAPERS &nbsp;·&nbsp; BUSINESS &amp; PROFESSIONAL CONTEXT
        &nbsp;·&nbsp; THE DIGITAL ENVIRONMENT
      </p>

      <div class="hero-btns">
        <a href="/signin" class="btn-primary">ACCESS THE PLATFORM →</a>
        <a href="#papers" class="btn-secondary">SEE CONTENT AREAS</a>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section" id="papers">
      <div class="section-inner">
        <div class="s-eyebrow fade-up">CONTENT AREAS</div>
        <h2 class="s-title fade-up">
          Two papers.<br />All topic areas covered.
        </h2>
        <p class="s-sub fade-up">
          Each topic area contains teacher-written content and a knowledge check.
          Work through them in order or go straight to your weak areas.
        </p>
        <div class="papers-grid fade-up">
          <a href="/content-areas/4-1" class="paper-card p1">
            <div class="paper-num">// CORE PAPER ONE</div>
            <div class="paper-title">Business &amp; Professional Context</div>
            <div class="paper-topics">
              <div class="topic-item">
                <div class="topic-dot"></div>
                Business types, structures and functions
              </div>
              <div class="topic-item">
                <div class="topic-dot"></div>
                Project management principles
              </div>
              <div class="topic-item">
                <div class="topic-dot"></div>
                Professional responsibilities and ethics
              </div>
              <div class="topic-item">
                <div class="topic-dot"></div>
                Working practices and legislation
              </div>
              <div class="topic-item">
                <div class="topic-dot"></div>
                Security in a business context
              </div>
              <div class="topic-item">
                <div class="topic-dot"></div>
                Sustainability and emerging trends
              </div>
            </div>
            <div class="paper-cta">EXPLORE PAPER ONE →</div>
          </a>

          <a href="/content-areas/7-2" class="paper-card p2">
            <div class="paper-num">// CORE PAPER TWO</div>
            <div class="paper-title">The Digital Environment</div>
            <div class="paper-topics">
              <div class="topic-item">
                <div class="topic-dot"></div>
                Hardware, software and operating systems
              </div>
              <div class="topic-item">
                <div class="topic-dot"></div>
                Networking and connectivity
              </div>
              <div class="topic-item">
                <div class="topic-dot"></div>
                Data and information management
              </div>
              <div class="topic-item">
                <div class="topic-dot"></div>
                Cybersecurity threats and countermeasures
              </div>
              <div class="topic-item">
                <div class="topic-dot"></div>
                Emerging technologies
              </div>
              <div class="topic-item">
                <div class="topic-dot"></div>
                Digital systems and infrastructure
              </div>
            </div>
            <div class="paper-cta">EXPLORE PAPER TWO →</div>
          </a>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section" id="activities">
      <div class="section-inner">
        <div class="s-eyebrow fade-up">ACTIVITIES</div>
        <h2 class="s-title fade-up">
          Three drills.<br />One Answer Arc.
        </h2>
        <p class="s-sub fade-up">
          Each activity targets a different shape of extended-answer
          question. Work through them in any order; per-attempt data is
          logged to your Signal account so progress is preserved across
          sessions.
        </p>
        <div class="activities-grid fade-up">
          <a href="/content-areas/risk-classifier" class="activity-card">
            <div class="activity-eyebrow">// UK LEGISLATION</div>
            <div class="activity-title">Risk Classifier</div>
            <div class="activity-desc">
              Classify workplace digital scenarios into one of four UK
              legislation tiers. Marker-style feedback on every
              classification.
            </div>
            <div class="activity-drills">
              Drills the Name component of the Answer Arc.
            </div>
            <div class="activity-cta">START CLASSIFYING →</div>
          </a>

          <a href="/content-areas/sort-and-match" class="activity-card">
            <div class="activity-eyebrow">// N·E·I RECOGNITION</div>
            <div class="activity-title">Sort &amp; Match</div>
            <div class="activity-desc">
              Drag whole-sentence phrases into Name, Explain, and Impact
              buckets for worked examples. Three-attempt stuck mitigation
              with a model-answer reveal.
            </div>
            <div class="activity-drills">
              Drills full Answer Arc recognition.
            </div>
            <div class="activity-cta">START SORTING →</div>
          </a>

          <a href="/content-areas/twin-tracks" class="activity-card">
            <div class="activity-eyebrow">// DISCUSS-STYLE</div>
            <div class="activity-title">Twin Tracks</div>
            <div class="activity-desc">
              Drag phrases into a six-cell grid for Discuss-style
              questions. Per-drop diagnostic feedback distinguishes
              track-error from slot-error.
            </div>
            <div class="activity-drills">
              Drills two-dimensional analytical structure.
            </div>
            <div class="activity-cta">START PLACING →</div>
          </a>
        </div>
        <p class="activities-followup fade-up">
          <a href="/activities" class="activities-followup-link">
            See all activities in one place →
          </a>
        </p>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="arc-section" id="answer-arc">
      <div class="arc-inner">
        <div class="s-eyebrow fade-up">TRY THE ANSWER ARC</div>
        <h2 class="s-title fade-up">
          A complete answer travels<br />from name to consequence.
        </h2>
        <p class="s-sub fade-up">
          Every extended question rewards the same movement. Name the concept,
          explain the mechanism, describe the real-world impact. Three marks,
          three moves. Try one now.
        </p>
        <AnswerArcDemo client:load />
        <p class="arc-followup fade-up">
          <a href="/content-areas/method" class="arc-followup-link">
            See the Answer Arc applied across worked examples →
          </a>
        </p>
      </div>
    </section>
  </main>
</LandingLayout>

<script>
  // Smooth-scroll anchor clicks. Lifted from the Edtech source.
  document.querySelectorAll('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const hrefAttr = a.getAttribute('href');
      if (!hrefAttr) return;
      const target = document.querySelector(hrefAttr);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // Fade-up on scroll using IntersectionObserver.
  // Add .visible to .fade-up elements as they enter the viewport.
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 },
  );
  document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));

  // Nav shrink on scroll (matches legacy behaviour).
  const nav = document.querySelector<HTMLElement>('.nav');
  if (nav) {
    window.addEventListener(
      'scroll',
      () => {
        nav.style.height = window.scrollY > 60 ? '48px' : '60px';
        nav.style.transition = 'height 0.3s ease';
      },
      { passive: true },
    );
  }
</script>
