---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import AuthorByline from '~/components/AuthorByline.astro';
import TopicMeta from '~/components/TopicMeta.astro';
import AssessmentBlock from "~/components/AssessmentBlock.astro";
import DrillPanel from "~/components/DrillPanel.astro";
import Breadcrumb from '~/components/Breadcrumb.astro';
import type { Crumb } from '~/components/Breadcrumb.astro';
import "~/styles/comic.css";

export async function getStaticPaths() {
  const topics = await getCollection(
    'topics',
    (t) => t.data.status === 'published'
  );
  return topics.map((topic) => ({
    params: { slug: topic.id },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);
const area = await getEntry('contentAreas', topic.data.content_area);
const isComic = topic.data.display_style === 'comic';

const crumbs: Crumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Content', href: '/content' },
];
if (area) {
  const paperLabel =
    area.data.paper === 'method' ? 'Method' : `Paper ${area.data.paper}`;
  crumbs.push({
    label: `${paperLabel} · ${area.data.display_code} ${area.data.title}`,
    href: `/content-areas/${area.id}`,
  });
}
crumbs.push({ label: topic.data.title });
---

<BaseLayout
  title={topic.data.title}
  description={`Section ${topic.data.section_id}. ${topic.data.paper === 'method' ? 'Method.' : `Paper ${topic.data.paper}.`}`}
>
  {isComic ? (
    <div class="comic-topic">
      <main>
        <Breadcrumb crumbs={crumbs} />
        <p class="comic-eyebrow">
          {topic.data.paper === 'method' ? 'Method' : `Paper ${topic.data.paper}`}
          {area && ` · ${area.data.display_code} ${area.data.title}`}
        </p>
        <h1>{topic.data.title}</h1>

        <AuthorByline authorIds={topic.data.authors} />

        <Content />

        {topic.data.drill.length > 0 && (
          <div class="comic-drill">
            <div class="comic-divider"><span class="line"></span><span class="tag">DRILL</span><span class="line"></span></div>
            <DrillPanel topicId={topic.id} items={topic.data.drill} />
          </div>
        )}

        {topic.data.assessments.length > 0 && (
          <div class="comic-assessment" id="nei-assessment">
            <div class="comic-divider"><span class="line"></span><span class="tag">ASSESSMENT</span><span class="line"></span></div>
            <AssessmentBlock topicId={topic.id} assessments={topic.data.assessments} />
          </div>
        )}

        <p style="margin-top: 3rem;">
          {area ? (
            <a href={`/content-areas/${area.id}`}>
              ← Back to {area.data.display_code} {area.data.title}
            </a>
          ) : (
            <a href="/">← Back to home</a>
          )}
        </p>
      </main>
    </div>
  ) : (
    <main class="container">
      <Breadcrumb crumbs={crumbs} />
      <div class="eyebrow">
        {topic.data.paper === 'method' ? 'Method' : `Paper ${topic.data.paper}`}
        {area && ` · ${area.data.display_code} ${area.data.title}`}
      </div>
      <h1>{topic.data.title}</h1>

      <AuthorByline authorIds={topic.data.authors} />

      <TopicMeta
        estimated_minutes={topic.data.estimated_minutes}
        learning_outcomes={topic.data.learning_outcomes}
        prerequisites={topic.data.prerequisites}
        section_id={topic.data.section_id}
        spec_version={topic.data.spec_version}
      />

      <article class="prose">
        <Content />
      </article>

      {topic.data.drill.length > 0 && (
        <DrillPanel topicId={topic.id} items={topic.data.drill} />
      )}

      <div id="nei-assessment">
        <AssessmentBlock topicId={topic.id} assessments={topic.data.assessments} />
      </div>

      <p style="margin-top: var(--space-5);">
        {area ? (
          <a href={`/content-areas/${area.id}`}>
            ← Back to {area.data.display_code} {area.data.title}
          </a>
        ) : (
          <a href="/">← Back to home</a>
        )}
      </p>
    </main>
  )}
</BaseLayout>

{isComic && (
  <script is:inline>
    (function () {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.18, rootMargin: '0px 0px -40px 0px' }
      );
      document
        .querySelectorAll('.comic-topic .comic-panel, .comic-topic .comic-closer')
        .forEach((el) => observer.observe(el));
    })();
  </script>
)}
