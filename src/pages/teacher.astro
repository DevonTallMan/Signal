---
// src/pages/teacher.astro
//
// Teacher dashboard route. Static-built shell that mounts the
// TeacherView React island. The island handles auth, allowlist check
// and the cohort-data fetch client-side; this Astro page only
// provides the page chrome and passes the topic catalogue as a prop
// so the per-topic tab can list every topic, including those with
// zero cohort activity.
//
// Sprint 7A Inc 7.1 shipped the cohort tab. Inc 7.2 adds per-topic
// and per-student tabs on the same island. Export endpoint lands in
// Inc 7.3.

import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import TeacherView, {
  type TopicMeta,
} from "../components/Teacher/TeacherView.tsx";

const topics = await getCollection(
  "topics",
  (t) => t.data.status === "published",
);
const topicCatalog: TopicMeta[] = topics
  .map((t) => ({
    id: t.id,
    title: t.data.title,
    sectionId: t.data.section_id,
    contentArea: t.data.content_area,
  }))
  .sort((a, b) => a.sectionId.localeCompare(b.sectionId));

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Teacher" },
];
---

<BaseLayout
  title="Teacher dashboard"
  description="Pilot teacher view: cohort progress at a glance."
>
  <main class="container">
    <Breadcrumb crumbs={crumbs} />
    <div class="eyebrow">Pilot · Teacher</div>
    <h1>Teacher dashboard</h1>
    <p class="lede">
      Cohort progress at a glance. Reads run client-side and are
      gated by the Firestore teacher allowlist.
    </p>

    <TeacherView topics={topicCatalog} client:only="react" />
  </main>
</BaseLayout>

<style>
  .teacher {
    margin-top: var(--space-4);
  }
  .teacher__signedin {
    font-family: monospace;
    color: var(--text-muted, #6a7090);
    margin-bottom: var(--space-3);
  }
  .teacher__tabs {
    display: flex;
    gap: 4px;
    margin: var(--space-3) 0;
    border-bottom: 2px solid rgba(0, 0, 0, 0.08);
  }
  .teacher__tab {
    background: transparent;
    border: none;
    padding: 8px 14px;
    font-family: inherit;
    font-size: 14px;
    color: var(--text-muted, #6a7090);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
  }
  .teacher__tab:hover {
    color: inherit;
  }
  .teacher__tab--active {
    color: inherit;
    border-bottom-color: currentColor;
    font-weight: 600;
  }
  .teacher__picker {
    margin: var(--space-3) 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .teacher__picker label {
    font-size: 14px;
    color: var(--text-muted, #6a7090);
  }
  .teacher__picker select {
    font-family: inherit;
    font-size: 14px;
    padding: 4px 8px;
  }
  .teacher__table {
    width: 100%;
    border-collapse: collapse;
    margin-top: var(--space-3);
  }
  .teacher__table th,
  .teacher__table td {
    text-align: left;
    padding: 8px 12px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  .teacher__table thead th {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted, #6a7090);
  }
  .teacher__table tbody th {
    font-weight: 600;
  }
  .teacher__footer {
    margin-top: var(--space-3);
    font-size: 14px;
    color: var(--text-muted, #6a7090);
  }
</style>
