---
// Twin Tracks - Discuss-style two-dimensional drag-and-drop interactive module.
// Sprint 4 worked example: Hospital Remote Access.
//
// Sprint 4 Increment 4.1 scope: static UI shell. Renders the scenarioPanels
// comic strip, the 6-phrase pool as static cards, and the 6-cell grid
// (positive top row, negative bottom row; introduce/explain/develop columns)
// with a one-line framing caption. Drag-and-drop, validation, persistence,
// and session loop land in subsequent increments per docs/sprint-4-scope.md.
//
// See docs/sort-and-match-nei-spec.md for full Twin Tracks spec.
import BaseLayout from "../../layouts/BaseLayout.astro";
import TwinTracksIsland from "../../components/twin-tracks";
import Breadcrumb from "../../components/Breadcrumb.astro";
---
<BaseLayout title="Twin Tracks | Signal">
  <main class="twin-tracks-page">
    <Breadcrumb
      crumbs={[
        { label: "Home", href: "/" },
        { label: "Activities", href: "/activities" },
        { label: "Twin Tracks" },
      ]}
    />
    <header class="tt-intro">
      <p class="tt-intro__kicker">DISCUSS-STYLE WORKED EXAMPLE</p>
      <h1 class="tt-intro__title">Twin Tracks</h1>
      <p class="tt-intro__lede">
        Name one positive impact and one negative impact, then develop each
        through Introduce, Explain, and Develop.
      </p>
    </header>
    <section class="tt-game">
      <TwinTracksIsland client:only="react" />
    </section>
    <footer class="tt-outro">
      <p>
        Sprint 4 Increment 4.1: static UI shell. Drag-and-drop, validation,
        and session persistence land in subsequent increments.
      </p>
    </footer>
  </main>
</BaseLayout>
<style>
  .twin-tracks-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }
  .tt-intro { margin-bottom: 2rem; }
  .tt-intro__kicker {
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--green, #39ff14);
    margin: 0 0 0.75rem;
  }
  .tt-intro__title {
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--ink, #e8edf3);
    margin: 0 0 0.75rem;
    letter-spacing: -0.01em;
  }
  .tt-intro__lede {
    font-size: 1.05rem;
    color: var(--dim, rgba(232, 237, 243, 0.75));
    margin: 0;
    max-width: 68ch;
  }
  .tt-game {
    margin: 2rem 0;
    min-height: 600px;
    background: var(--panel, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: 4px;
    padding: 1.5rem;
  }
  .tt-outro {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    font-size: 0.85rem;
    color: var(--muted, rgba(232, 237, 243, 0.55));
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .twin-tracks-page { padding: 1.5rem 1rem 3rem; }
    .tt-intro__title { font-size: 2rem; }
    .tt-game { padding: 1rem; min-height: 500px; }
  }
</style>
