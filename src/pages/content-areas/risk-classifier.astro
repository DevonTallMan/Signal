---
// Risk Classifier - UK Legislation interactive module.
// Pivoted from EU AI Act on 24 April 2026 after spec mismatch discovered.
// See docs/sprint-2-scope.md and src/data/risk-classifier/README.md.
//
// Phase 1 A4: narrative wrapper around the activity. Methodology-depth
// framing that connects the classifier to the Answer Arc (Name component)
// and threads through to Sort & Match for the full N·E·I treatment. No
// changes to the React island or any other code; copy-only.

import BaseLayout from "../../layouts/BaseLayout.astro";
import RiskClassifierIsland from "../../components/RiskClassifier";
import Breadcrumb from "../../components/Breadcrumb.astro";
---

<BaseLayout title="Risk Classifier | Signal">
  <main class="risk-classifier-page">
    <Breadcrumb
      crumbs={[
        { label: "Home", href: "/" },
        { label: "Activities", href: "/activities" },
        { label: "Risk Classifier" },
      ]}
    />
    <header class="rc-intro">
      <p class="rc-intro__kicker">UK LEGISLATION INTERACTIVE</p>
      <h1 class="rc-intro__title">Risk Classifier</h1>
      <p class="rc-intro__lede">
        Five workplace digital scenarios land in front of you, one at a
        time. For each, identify which UK Act primarily applies: Data
        Protection, Computer Misuse, Equality, or Intellectual Property.
        The platform tells you why you were right or where you went
        wrong. The exam will not.
      </p>
      <p class="rc-intro__methodology">
        <span class="rc-intro__methodology-kicker">// WHAT THIS DRILLS</span>
        The <strong>Name</strong> component of the Answer Arc for Paper 1
        legislation-application questions. Naming the correct Act is the
        foundation step. Get it consistent here, then take the rest of
        the answer through Sort &amp; Match.
      </p>
    </header>

    <section class="rc-game">
      <RiskClassifierIsland client:only="react" />
    </section>

    <footer class="rc-outro">
      <p class="rc-outro__kicker">// WHAT TO DO NEXT</p>
      <p>
        Risk Classifier drills legislation recognition: the Name
        component of the Answer Arc for Paper 1 legal-context questions.
        Once you can identify the right Act consistently, <a
          href="/content-areas/sort-and-match"
          class="rc-outro__link">Sort &amp; Match</a> takes you the rest
        of the way to a full N·E·I answer. The methodology behind both
        activities is in the <a
          href="/content-areas/method"
          class="rc-outro__link">Method section</a>.
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  .risk-classifier-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }
  .rc-intro { margin-bottom: 2rem; }
  .rc-intro__kicker {
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--green, #39ff14);
    margin: 0 0 0.75rem;
  }
  .rc-intro__title {
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--ink, #e8edf3);
    margin: 0 0 0.75rem;
    letter-spacing: -0.01em;
  }
  .rc-intro__lede {
    font-size: 1.05rem;
    color: var(--dim, rgba(232, 237, 243, 0.75));
    margin: 0;
    max-width: 68ch;
    line-height: 1.6;
  }
  .rc-intro__methodology {
    margin: 1.25rem 0 0;
    padding: 0.875rem 1rem;
    background: var(--void, rgba(0, 0, 0, 0.25));
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-left: 2px solid var(--green, #39ff14);
    border-radius: 2px;
    font-size: 0.95rem;
    color: var(--dim, rgba(232, 237, 243, 0.75));
    line-height: 1.6;
    max-width: 68ch;
  }
  .rc-intro__methodology-kicker {
    display: block;
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--green, #39ff14);
    margin-bottom: 0.4rem;
  }
  .rc-intro__methodology strong {
    color: var(--ink, #e8edf3);
    font-weight: 600;
  }
  .rc-game {
    margin: 2rem 0;
    min-height: 600px;
    background: var(--panel, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: 4px;
    padding: 1.5rem;
  }
  .rc-outro {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    font-size: 0.9rem;
    color: var(--dim, rgba(232, 237, 243, 0.75));
    line-height: 1.6;
    max-width: 68ch;
  }
  .rc-outro__kicker {
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--green, #39ff14);
    margin: 0 0 0.6rem;
  }
  .rc-outro__link {
    color: var(--green, #39ff14);
    text-decoration: none;
    border-bottom: 1px solid rgba(57, 255, 20, 0.3);
    transition: color 160ms ease, border-color 160ms ease;
  }
  .rc-outro__link:hover,
  .rc-outro__link:focus-visible {
    color: var(--ink, #e8edf3);
    border-bottom-color: var(--green, #39ff14);
  }
  @media (max-width: 640px) {
    .risk-classifier-page { padding: 1.5rem 1rem 3rem; }
    .rc-intro__title { font-size: 2rem; }
    .rc-game { padding: 1rem; min-height: 500px; }
  }
</style>

