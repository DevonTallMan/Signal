---
// Risk Classifier - UK Legislation interactive module.
// Pivoted from EU AI Act on 24 April 2026 after spec mismatch discovered.
// See docs/sprint-2-scope.md and src/data/risk-classifier/README.md.
//
// Sprint 2 Increment 4 scope: Firestore writeAttempt for each click (authenticated only).

import BaseLayout from "../../layouts/BaseLayout.astro";
import RiskClassifierIsland from "../../components/RiskClassifier";
---

<BaseLayout title="Risk Classifier | Signal">
  <main class="risk-classifier-page">
    <header class="rc-intro">
     <p class="rc-intro__kicker">UK LEGISLATION INTERACTIVE</p>
      <h1 class="rc-intro__title">Risk Classifier</h1>
      <p class="rc-intro__lede">
        Classify workplace digital scenarios against UK legislation: Data
        Protection, Computer Misuse, Equality, and Intellectual Property. Learn
        by doing.
      </p>
    </header>

    <section class="rc-game">
      <RiskClassifierIsland client:only="react" />
    </section>

    <footer class="rc-outro">
      <p>
       Sprint 2 Increment 4: each classification is persisted to Firestore for
        authenticated users. Continue button still does not advance; that
        arrives in Increment 5 alongside the multi-scenario session loop.
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  .risk-classifier-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }
  .rc-intro { margin-bottom: 2rem; }
  .rc-intro__kicker {
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--green, #39ff14);
    margin: 0 0 0.75rem;
  }
  .rc-intro__title {
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--ink, #e8edf3);
    margin: 0 0 0.75rem;
    letter-spacing: -0.01em;
  }
  .rc-intro__lede {
    font-size: 1.05rem;
    color: var(--dim, rgba(232, 237, 243, 0.75));
    margin: 0;
    max-width: 68ch;
  }
  .rc-game {
    margin: 2rem 0;
    min-height: 600px;
    background: var(--panel, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: 4px;
    padding: 1.5rem;
  }
  .rc-outro {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    font-size: 0.85rem;
    color: var(--muted, rgba(232, 237, 243, 0.55));
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .risk-classifier-page { padding: 1.5rem 1rem 3rem; }
    .rc-intro__title { font-size: 2rem; }
    .rc-game { padding: 1rem; min-height: 500px; }
  }
</style>

